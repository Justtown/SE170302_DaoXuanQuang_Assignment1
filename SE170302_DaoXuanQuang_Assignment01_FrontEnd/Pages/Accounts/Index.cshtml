@page
@model SE170302_DaoXuanQuang_Assignment01_FrontEnd.Pages.Accounts.IndexModel
@{
    ViewData["Title"] = "Account Management";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>👤 Account Management</h2>
        <a asp-page="./Create" class="btn btn-success">➕ Create New</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Email</th>
                <th>Role</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Accounts)
            {
                <tr>
                    <td>@item.AccountId</td>
                    <td>@item.AccountName</td>
                    <td>@item.AccountEmail</td>
                    <td>
                        @if (item.AccountRole == 1)
                        {
                            <span class="badge bg-danger">Admin</span>
                        }
                        else if (item.AccountRole == 2)
                        {
                            <span class="badge bg-primary">Staff</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Lecturer</span>
                        }
                    </td>
                    <td>
                        <a asp-page="./Edit" asp-route-id="@item.AccountId" class="btn btn-warning btn-sm">Edit</a>
                        <form method="post" asp-page-handler="Delete" asp-route-id="@item.AccountId"
                              class="d-inline" onsubmit="return confirm('Delete this account?');">
                            <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>