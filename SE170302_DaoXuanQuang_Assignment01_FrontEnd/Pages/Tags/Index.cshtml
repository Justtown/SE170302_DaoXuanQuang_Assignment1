@page
@model SE170302_DaoXuanQuang_Assignment01_FrontEnd.Pages.Tags.IndexModel
@{
    ViewData["Title"] = "Tag Management";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>🏷️ Tag Management</h2>
        <a asp-page="./Create" class="btn btn-success">➕ Create New</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Tag Name</th>
                <th>Note</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Tags)
            {
                <tr>
                    <td>@item.TagId</td>
                    <td>@item.TagName</td>
                    <td>@item.Note</td>
                    <td>
                        <a asp-page="./Edit" asp-route-id="@item.TagId" class="btn btn-warning btn-sm">Edit</a>
                        <form method="post" asp-page-handler="Delete" asp-route-id="@item.TagId"
                              class="d-inline" onsubmit="return confirm('Delete this tag?');">
                            <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>