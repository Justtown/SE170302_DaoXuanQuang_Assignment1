@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    var role = HttpContextAccessor.HttpContext?.Session.GetString("AccountRole");
    var accountName = HttpContextAccessor.HttpContext?.Session.GetString("AccountName");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FU News Management</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-page="/Index">FU News Management</a>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item"><a class="nav-link text-dark" asp-page="/Index">Home</a></li>

                        @if (role == "1" || role == "2")
                        {
                            <li class="nav-item"><a class="nav-link text-dark" asp-page="/News/Index">News</a></li>
                        }
                        @if (role == "1" || role == "2")
                        {
                            <li class="nav-item"><a class="nav-link text-dark" asp-page="/Categories/Index">Categories</a></li>
                            <li class="nav-item"><a class="nav-link text-dark" asp-page="/Tags/Index">Tags</a></li>
                        }
                        @if (role == "1")
                        {
                            <li class="nav-item"><a class="nav-link text-dark" asp-page="/Accounts/Index">Accounts</a></li>
                            <li class="nav-item"><a class="nav-link text-dark" asp-page="/Report">Report</a></li>
                        }
                    </ul>
                    <ul class="navbar-nav">
                        @if (!string.IsNullOrEmpty(accountName))
                        {
                            <li class="nav-item"><span class="nav-link text-dark">👤 @accountName</span></li>
                            <li class="nav-item"><a class="nav-link text-dark" asp-page="/Logout">Logout</a></li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link text-dark" asp-page="/Login">Login</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>